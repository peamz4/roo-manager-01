# Discord OAuth App credentials (discord.com/developers → Your App → OAuth2)
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Must match exactly what you set in Discord → OAuth2 → Redirects
# Local:  http://localhost:3000/auth/discord/callback
# Vercel: https://your-app.vercel.app/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Long random string for signing JWT tokens
JWT_SECRET=some-long-random-secret

# Comma-separated Discord usernames allowed in (case-insensitive)
ALLOWED_DISCORD_USERNAMES=username1,username2

PORT=3000
